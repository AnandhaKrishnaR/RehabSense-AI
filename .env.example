# ==========================================
# RehabSense AI - Environment Configuration
# ==========================================

# -----------------
# Backend Settings
# -----------------
DEBUG=True
SECRET_KEY=django-insecure-rehabsense-hackathon-development-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration (defaults to local SQLite if DATABASE_URL is not set)
# For PostgreSQL: DATABASE_URL=postgres://user:password@localhost:5432/rehabsense
DATABASE_URL=sqlite:///db.sqlite3

# Voice Adapter Settings
# Options: sarvam, mock, gtts, ai4bharat, whisper
MALAYALAM_VOICE_PROVIDER=sarvam
TTS_PROVIDER=gemini

# Sarvam AI Malayalam Configuration (Recommended for hackathon live demo)
# Sign up at https://sarvam.ai/ to obtain an API subscription key
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_LANGUAGE_CODE=ml-IN
SARVAM_TIMEOUT_SECONDS=15.0
SARVAM_TTS_PACE=1.0
SARVAM_TTS_SAMPLE_RATE=22050
SARVAM_TTS_DICT_ID=

# Google Gemini Malayalam Text-to-Speech (backend only)
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_TIMEOUT_SECONDS=30.0

# Optional Alternative External API Keys (Leave blank for mock mode)
AI4BHARAT_API_KEY=
WHISPER_API_KEY=

# Safety / Demo Mode
DEMO_MODE=True

# -----------------
# Frontend Settings
# -----------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEMO_MODE=true
VITE_VOICE_LANGUAGE=ml-IN

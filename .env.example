# ==========================================
# RehabSense AI - Environment Configuration
# ==========================================

# -----------------
# Backend Settings
# -----------------
DEBUG=True
SECRET_KEY=django-insecure-rehabsense-hackathon-development-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration (defaults to local SQLite if DATABASE_URL is not set)
# For PostgreSQL: DATABASE_URL=postgres://user:password@localhost:5432/rehabsense
DATABASE_URL=sqlite:///db.sqlite3

# Voice Adapter Settings
# Options: mock, ai4bharat, whisper
MALAYALAM_VOICE_PROVIDER=mock
# Optional External API Keys (Leave blank for mock mode)
AI4BHARAT_API_KEY=
WHISPER_API_KEY=

# Safety / Demo Mode
DEMO_MODE=True

# -----------------
# Frontend Settings
# -----------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEMO_MODE=true
VITE_VOICE_LANGUAGE=ml-IN
VITE_AVATAR_MODEL_URL=/assets/rehabsense-avatar.glb

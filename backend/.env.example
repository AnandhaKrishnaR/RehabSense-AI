# Backend Environment Configuration (.env)
DEBUG=True
SECRET_KEY=django-insecure-rehabsense-hackathon-development-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=True

# Database (Default: local SQLite; PostgreSQL can be specified via DATABASE_URL)
# DATABASE_URL=postgres://user:password@localhost:5432/rehabsense

# Malayalam Voice Provider (Options: sarvam, mock, gtts, whisper, ai4bharat)
MALAYALAM_VOICE_PROVIDER=sarvam
TTS_PROVIDER=sarvam

# Sarvam AI Malayalam Configuration (Recommended for hackathon live demo)
# Sign up at https://sarvam.ai/ to obtain an API subscription key
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_LANGUAGE_CODE=ml-IN
SARVAM_TIMEOUT_SECONDS=15.0
SARVAM_TTS_PACE=1.0
SARVAM_TTS_SAMPLE_RATE=22050
SARVAM_TTS_DICT_ID=

# Optional Alternative Voice Providers
OPENAI_API_KEY=
AI4BHARAT_API_KEY=

# Hackathon Demo Mode
DEMO_MODE=True

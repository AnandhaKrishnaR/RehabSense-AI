# Backend Environment Configuration (.env)
DEBUG=True
SECRET_KEY=django-insecure-rehabsense-hackathon-development-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=True

# Database (Default: local SQLite; PostgreSQL can be specified via DATABASE_URL)
# DATABASE_URL=postgres://user:password@localhost:5432/rehabsense

# Malayalam Voice Provider (Options: mock, whisper, ai4bharat, gtts)
MALAYALAM_VOICE_PROVIDER=mock
OPENAI_API_KEY=
AI4BHARAT_API_KEY=

# Hackathon Demo Mode
DEMO_MODE=True
